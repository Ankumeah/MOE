#!/usr/bin/env bash
# MoE AI launcher
#
# Usage:
#   ./moe-ai            # install deps (first run), start server, open browser
#   ./moe-ai --no-open  # start server without opening a browser
#   ./moe-ai --port 8080

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PORT="3000"
OPEN_BROWSER=1

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-open) OPEN_BROWSER=0; shift ;;
    --port)
      PORT="$2"; shift 2
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: ./moe-ai [--no-open] [--port PORT]" >&2
      exit 1
      ;;
  esac
done

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is required but was not found. Install it first: https://nodejs.org" >&2
  exit 1
fi

if [[ ! -d "$DIR/node_modules" ]]; then
  echo "Installing dependencies…"
  (cd "$DIR" && npm install --ignore-scripts)
fi

if [[ ! -f "$DIR/.env" && -f "$DIR/.env.example" ]]; then
  cp "$DIR/.env.example" "$DIR/.env"
  echo "Created .env from .env.example (add API keys there or in the app's Settings page)."
fi

URL="http://localhost:$PORT"

if [[ "$OPEN_BROWSER" -eq 1 ]]; then
  (
    sleep 2
    if command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
    elif command -v open >/dev/null 2>&1; then open "$URL" >/dev/null 2>&1 || true
    fi
  ) &
fi

echo
echo "  MoE AI — Mixture-of-Experts demonstration"
echo "  ➜  $URL"
echo "  Press Ctrl+C to stop."
echo

cd "$DIR"
exec env PORT="$PORT" node server/index.js
